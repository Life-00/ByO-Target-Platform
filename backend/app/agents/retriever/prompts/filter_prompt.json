    "labeling_rules": {
      "general": [
        "Label only what is explicitly stated or strongly implied by title/abstract/metadata.",
        "If a bucket is not supported by explicit text, leave it empty.",
        "Do not invent labels."
      ],
      "required_modality_gate": [
        "If the query explicitly requires a modality (e.g., PROTAC, mRNA/siRNA/ASO), then the paper must explicitly mention that modality; otherwise DROP."
      ],
      "required_target_use_gate": [
        "If the query explicitly requires veterinary/aquaculture/companion vs human context, mismatch => DROP."
      ]
    },

    "reasoning_procedure": {
      "note": "Execute internally. Do not expose reasoning steps in the output.",
      "steps": [
        {
          "step": "1) Query Labeling",
          "description": "Infer 0-3 labels per relevant taxonomy bucket for the query. Only label what is explicit or strongly implied."
        },
        {
          "step": "2) Paper Labeling",
          "description": "Infer 0-3 labels per relevant taxonomy bucket for the paper using title/abstract. Only label when explicitly supported."
        },
        {
          "step": "3) Compatibility Check",
          "description": "Check label compatibility. If the query has a required constraint (modality/target_use/organ context), mismatch => DROP."
        },
        {
          "step": "4) Query-to-Criteria",
          "description": "Convert query into 3–6 inclusion criteria (context/entity/relationship/constraints)."
        },
        {
          "step": "5) Evidence Matching",
          "description": "Verify criteria are explicitly satisfied in title/abstract."
        },
        {
          "step": "6) Extractability Gate",
          "description": "Confirm at least one atomic, citeable claim can be extracted from the abstract."
        }
      ]
    },

    "hard_negative_rules": [
      "If the paper is about an unrelated biological domain, organism, or disease area, DROP with confidence >= 0.9.",
      "If query is bone/osteogenesis context and paper is oral microbiology/antibiotics with no bone relevance, DROP.",
      "If the paper is purely methods/assay/platform with no biomedical relationship relevant to the query entities, DROP (unless the query is explicitly about methods)."
    ],

    "special_constraint_rules": [
      {
        "condition": "Query requires non-small-molecule modulation (e.g., PROTAC or RNA-based specifically)",
        "requirement": "Paper must explicitly mention the required modality (PROTAC/degrader OR RNA modality keywords).",
        "violation_action": "DROP"
      }
    ],

    "evidence_reporting_rule": {
      "requirement": "In reasons[] include a short 'labels:' summary string like: labels_query={...} labels_paper={...} mismatch={...}. Keep it short and grounded.",
      "note": "This is not a new JSON field—just a formatted string inside reasons[] or checklist evidence."
    }
  },

  "decision_policy": {
    "KEEP": [
      "TargetExplicit == true",
      "DiseaseContext == true OR therapy/organ context is explicitly aligned",
      "RelationPresent == true",
      "ExtractableClaim == true",
      "No hard negative triggered",
      "No special constraint violation",
      "Taxonomy labels are compatible (especially required modality/target_use)"
    ],
    "DROP": [
      "Hard negative triggered",
      "DiseaseContext == false AND no aligned therapy/organ context",
      "Special constraint violated",
      "Taxonomy mismatch on required modality or required target_use"
    ],
    "UNCERTAIN": [
      "Same general domain but missing explicit relation or key entity",
      "Abstract too vague for confident extraction",
      "Some labels match but modality/mechanism is not explicit"
    ]
  },

  "output_format": {
    "type": "json",
    "schema": {
      "decision": "KEEP | DROP | UNCERTAIN",
      "confidence": "float (0.0 - 1.0)",
      "reasons": "array of strings",
      "checklist": {
        "TargetExplicit": { "value": "true | false | unknown", "evidence": "string" },
        "DiseaseContext": { "value": "true | false | unknown", "evidence": "string" },
        "RelationPresent": { "value": "true | false | unknown", "evidence": "string" },
        "StudyType": { "value": "primary | review | unknown", "evidence": "string" },
        "TransferDiscussion": { "value": "true | false | unknown", "evidence": "string" },
        "ExtractableClaim": { "value": "true | false | unknown", "evidence": "string" }
      }
    }
  }
}
