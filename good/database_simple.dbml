// TVA Database - Simplified Version for dbdiagram.io
// PostgreSQL + ChromaDB Architecture

Project tva_database {
  database_type: 'PostgreSQL + ChromaDB'
}

// ============================================
// POSTGRESQL TABLES
// ============================================

Table users {
  id integer [pk, increment]
  email varchar(255) [unique, not null]
  username varchar(100) [unique, not null]
  hashed_password varchar(255) [not null]
  is_active boolean [default: true]
  is_admin boolean [default: false]
  created_at timestamp
  updated_at timestamp
}

Table sessions {
  id integer [pk, increment]
  user_id integer [ref: > users.id]
  title varchar(255) [not null]
  description text
  analysis_goal text
  is_active boolean [default: true]
  created_at timestamp
  updated_at timestamp
}

Table documents {
  id integer [pk, increment]
  user_id integer [ref: > users.id]
  session_id integer [ref: > sessions.id]
  title varchar(255) [not null]
  file_name varchar(255) [not null]
  file_path varchar(500) [not null]
  file_size integer [not null]
  page_count integer
  is_indexed boolean [default: false]
  indexed_at timestamp
  
  keywords json
  sections json
  extracted_abstract text
  summary text
  relevance_score float
  source varchar(50)
  
  created_at timestamp
  updated_at timestamp
}

Table document_chunks {
  id integer [pk, increment]
  document_id integer [ref: > documents.id]
  chunk_index integer [not null]
  page_number integer [not null]
  text_content text [not null]
  char_count integer [not null]
  chroma_id varchar(36) [unique, note: 'Links to ChromaDB']
  embedding_model varchar(100)
  created_at timestamp
}

Table chat_messages {
  id integer [pk, increment]
  session_id integer [ref: > sessions.id]
  user_id integer [ref: > users.id]
  document_id integer [ref: > documents.id]
  role varchar(20) [not null, note: 'user/assistant']
  content text [not null]
  model_used varchar(100)
  tokens_used integer
  created_at timestamptz
}

Table analysis_reports {
  id integer [pk, increment]
  document_id integer [ref: > documents.id]
  agent_type varchar(50) [not null]
  report_type varchar(50) [not null]
  title varchar(255) [not null]
  content text [not null]
  meta_data text
  is_public boolean [default: false]
  created_at timestamp
  updated_at timestamp
}

Table document_annotations {
  id integer [pk, increment]
  document_id integer [ref: > documents.id]
  user_id integer [ref: > users.id]
  page_number integer [not null]
  highlight_text text
  note text
  annotation_type varchar(50) [not null]
  created_at timestamp
  updated_at timestamp
}

Table agent_logs {
  id integer [pk, increment]
  agent_name varchar(100) [not null]
  document_id integer [ref: > documents.id]
  status varchar(20) [not null]
  input_data text
  output_data text
  error_message text
  execution_time_ms integer
  tokens_used integer
  created_at timestamp
  updated_at timestamp
}

Table search_cache {
  id integer [pk, increment]
  user_id integer [ref: > users.id]
  query_hash varchar(64) [not null]
  source varchar(20) [not null]
  papers_json text [not null]
  result_count integer [not null]
  ttl_seconds integer [default: 604800]
  created_at timestamp
  expires_at timestamp
  accessed_at timestamp
  access_count integer [default: 1]
}

Table search_history {
  id integer [pk, increment]
  user_id integer [ref: > users.id]
  session_id integer [ref: > sessions.id]
  query varchar(1000) [not null]
  source varchar(20) [not null]
  papers_found integer [not null]
  papers_downloaded integer [default: 0]
  papers_filtered integer [not null]
  min_relevance_score float
  max_relevance_score float
  avg_relevance_score float
  search_time_seconds float [not null]
  from_cache boolean [default: false]
  notes text
  created_at timestamp
}

Table api_usage {
  id integer [pk, increment]
  user_id integer [ref: > users.id]
  endpoint varchar(255) [not null]
  method varchar(10) [not null]
  status_code integer [not null]
  response_time_ms integer
  request_size_bytes integer
  response_size_bytes integer
  ip_address varchar(45)
  created_at timestamp
}

// ============================================
// CHROMADB (Vector Database)
// ============================================

Table chromadb_embeddings [headercolor: #4A90E2] {
  id varchar(36) [pk, note: 'UUID']
  embedding vector [note: '4096-dim vector']
  document text [note: 'Text chunk']
  
  metadata_document_id integer
  metadata_chunk_index integer
  metadata_page_number integer
  metadata_char_count integer
  metadata_embedding_model varchar(100)
  
  Note: '''
    ChromaDB Collection: documents
    Links to PostgreSQL: document_chunks.chroma_id = chromadb_embeddings.id
  '''
}

// ============================================
// TABLE GROUPS
// ============================================

TableGroup PostgreSQL {
  users
  sessions
  documents
  document_chunks
  chat_messages
  analysis_reports
  document_annotations
  agent_logs
  search_cache
  search_history
  api_usage
}

TableGroup ChromaDB {
  chromadb_embeddings
}
