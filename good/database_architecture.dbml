// PostgreSQL + ChromaDB
// Generated for dbdiagram.io visualization

Project tva_database {
  database_type: 'PostgreSQL + ChromaDB'
  Note: '''
    # TVA Database Architecture
    
    ## Components:
    1. **PostgreSQL** - Main relational database
       - User management & authentication
       - Document metadata
       - Chat history
       - Search cache & history
       - Agent logs & API usage
    
    2. **ChromaDB** - Vector database
       - Document embeddings storage
       - Semantic search
       - RAG (Retrieval Augmented Generation)
    
    ## Agents using DB:
    - **EmbeddingAgent**: PostgreSQL (document_chunks) + ChromaDB (embeddings)
    - **AnalysisAgent**: PostgreSQL (chat_messages) + ChromaDB (vector search)
    - **SearchAgent**: PostgreSQL (search_cache, search_history)
    - **GeneralChatAgent**: PostgreSQL (chat_messages)
  '''
}

// ============================================
// POSTGRESQL TABLES
// ============================================

Table users {
  id integer [pk, increment]
  email varchar(255) [unique, not null, note: 'Indexed for fast lookup']
  username varchar(100) [unique, not null, note: 'Indexed for fast lookup']
  hashed_password varchar(255) [not null]
  is_active boolean [not null, default: true]
  is_admin boolean [not null, default: false]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  
  indexes {
    email [name: 'idx_user_email']
    username [name: 'idx_user_username']
  }
  
  Note: '''
    Core user accounts table.
    Used by: All agents for authentication
    Created by: Auth API endpoints
  '''
}

Table sessions {
  id integer [pk, increment]
  user_id integer [ref: > users.id, not null, note: 'CASCADE delete']
  title varchar(255) [not null]
  description text
  analysis_goal text [note: 'User analysis target/goal per workspace']
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  
  indexes {
    user_id [name: 'idx_session_user_id']
    created_at [name: 'idx_session_created_at']
  }
  
  Note: '''
    Chat/Work sessions (workspaces).
    Used by: GeneralChatAgent, AnalysisAgent
    Created by: Session API
  '''
}

Table documents {
  id integer [pk, increment]
  user_id integer [ref: > users.id, not null, note: 'CASCADE delete']
  session_id integer [ref: > sessions.id, note: 'SET NULL on delete']
  title varchar(255) [not null]
  description text
  file_name varchar(255) [not null, note: 'Original filename']
  file_path varchar(500) [not null, note: 'Local or S3 path']
  file_size integer [not null, note: 'File size in bytes']
  page_count integer [note: 'Extracted from PDF']
  mime_type varchar(50) [not null, default: 'application/pdf']
  is_indexed boolean [not null, default: false, note: 'Whether text extracted & embedded']
  indexed_at timestamp
  
  // PDF Metadata
  keywords json [note: 'e.g., ["CRISPR", "gene-editing"]']
  sections json [note: 'e.g., ["1. Introduction", "2. Methods"]']
  extracted_abstract text [note: 'Abstract extracted from PDF']
  summary text [note: 'Generated by EmbeddingAgent/SummaryAgent']
  relevance_score float [note: '0-1 score from LLM filtering']
  source varchar(50) [note: 'arxiv, pubmed, manual_upload']
  external_id varchar(255) [note: 'arxiv/pubmed ID']
  
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  
  indexes {
    user_id [name: 'idx_document_user_id']
    session_id [name: 'idx_document_session_id']
    is_indexed [name: 'idx_document_indexed']
  }
  
  Note: '''
    PDF document metadata.
    Used by: EmbeddingAgent (indexing), AnalysisAgent (retrieval), SearchAgent (storage)
    Created by: Document upload API
    Updated by: EmbeddingAgent (summary, is_indexed)
  '''
}

Table document_chunks {
  id integer [pk, increment]
  document_id integer [ref: > documents.id, not null, note: 'CASCADE delete']
  chunk_index integer [not null, note: 'Order within document']
  page_number integer [not null]
  text_content text [not null]
  char_count integer [not null]
  chroma_id varchar(36) [unique, note: 'UUID linking to ChromaDB embedding']
  embedding_model varchar(100) [note: 'e.g., upstage-embedding-v1']
  created_at timestamp [not null, default: `now()`]
  
  indexes {
    document_id [name: 'idx_chunk_document_id']
    chroma_id [name: 'idx_chunk_chroma_id']
    page_number [name: 'idx_chunk_page_number']
  }
  
  Note: '''
    Text chunks for vector search.
    Created by: EmbeddingAgent
    Used by: AnalysisAgent (RAG retrieval)
    Links to: ChromaDB embeddings via chroma_id
  '''
}

Table chat_messages {
  id integer [pk, increment]
  session_id integer [ref: > sessions.id, not null, note: 'CASCADE delete']
  user_id integer [ref: > users.id, not null, note: 'CASCADE delete']
  document_id integer [ref: > documents.id, note: 'SET NULL on delete']
  role varchar(20) [not null, note: 'user or assistant']
  content text [not null]
  model_used varchar(100) [note: 'LLM model name']
  tokens_used integer [note: 'For usage tracking']
  created_at timestamptz [not null, default: `now()`]
  
  indexes {
    session_id [name: 'idx_message_session_id']
    user_id [name: 'idx_message_user_id']
    document_id [name: 'idx_message_document_id']
    created_at [name: 'idx_message_created_at']
  }
  
  Note: '''
    Chat conversation history.
    Created by: GeneralChatAgent, AnalysisAgent
    Used by: All chat agents for context
  '''
}

Table analysis_reports {
  id integer [pk, increment]
  document_id integer [ref: > documents.id, not null, note: 'CASCADE delete']
  agent_type varchar(50) [not null, note: 'search_indexer, pdf_analyzer, rag_agent, report_writer']
  report_type varchar(50) [not null, note: 'summary, analysis, extraction']
  title varchar(255) [not null]
  content text [not null]
  meta_data text [note: 'JSON string with analysis details']
  is_public boolean [not null, default: false]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  
  indexes {
    document_id [name: 'idx_report_document_id']
    agent_type [name: 'idx_report_agent_type']
  }
  
  Note: '''
    AI-generated analysis reports.
    Created by: AnalysisAgent, future report agents
  '''
}

Table document_annotations {
  id integer [pk, increment]
  document_id integer [ref: > documents.id, not null, note: 'CASCADE delete']
  user_id integer [ref: > users.id, not null, note: 'CASCADE delete']
  page_number integer [not null]
  highlight_text text
  note text
  annotation_type varchar(50) [not null, note: 'highlight, comment, bookmark']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  
  indexes {
    document_id [name: 'idx_annotation_document_id']
    user_id [name: 'idx_annotation_user_id']
  }
  
  Note: '''
    User annotations on documents.
    Created by: Frontend annotation UI
  '''
}

Table agent_logs {
  id integer [pk, increment]
  agent_name varchar(100) [not null, note: 'embedding_agent, analysis_agent, search_agent']
  document_id integer [ref: > documents.id, note: 'SET NULL on delete']
  status varchar(20) [not null, note: 'pending, running, completed, failed']
  input_data text [note: 'JSON input']
  output_data text [note: 'JSON output']
  error_message text
  execution_time_ms integer [note: 'Execution time in milliseconds']
  tokens_used integer
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  
  indexes {
    agent_name [name: 'idx_agent_log_agent_name']
    document_id [name: 'idx_agent_log_document_id']
    status [name: 'idx_agent_log_status']
    created_at [name: 'idx_agent_log_created_at']
  }
  
  Note: '''
    Execution logs for all agents.
    Created by: All agents during execution
    Used for: Monitoring, debugging, performance analysis
  '''
}

Table search_cache {
  id integer [pk, increment]
  user_id integer [ref: > users.id, not null, note: 'CASCADE delete']
  query_hash varchar(64) [not null, note: 'SHA-256 hash of query']
  source varchar(20) [not null, note: 'arxiv, pubmed, both']
  papers_json text [not null, note: 'JSON array of papers']
  result_count integer [not null]
  ttl_seconds integer [not null, default: 604800, note: '7 days']
  created_at timestamp [not null, default: `now()`]
  expires_at timestamp [not null, note: 'When cache expires']
  accessed_at timestamp [not null, default: `now()`]
  access_count integer [default: 1]
  
  indexes {
    user_id [name: 'idx_search_cache_user_id']
    query_hash [name: 'idx_search_cache_query_hash']
    expires_at [name: 'idx_search_cache_expires_at']
    (user_id, query_hash, source) [unique, name: 'uq_search_cache_user_query_source']
  }
  
  Note: '''
    Cache for search results (7 day TTL).
    Created by: SearchAgent
    Used by: SearchAgent to avoid duplicate API calls
  '''
}

Table search_history {
  id integer [pk, increment]
  user_id integer [ref: > users.id, not null, note: 'CASCADE delete']
  session_id integer [ref: > sessions.id, note: 'CASCADE delete']
  query varchar(1000) [not null]
  source varchar(20) [not null, note: 'arxiv, pubmed, both']
  papers_found integer [not null]
  papers_downloaded integer [default: 0]
  papers_filtered integer [not null, note: 'After relevance filtering']
  min_relevance_score float
  max_relevance_score float
  avg_relevance_score float
  search_time_seconds float [not null]
  from_cache boolean [default: false]
  notes text
  created_at timestamp [not null, default: `now()`]
  
  indexes {
    user_id [name: 'idx_search_history_user_id']
    session_id [name: 'idx_search_history_session_id']
    created_at [name: 'idx_search_history_created_at']
  }
  
  Note: '''
    User search history tracking.
    Created by: SearchAgent
    Used for: Analytics, search pattern analysis
  '''
}

Table api_usage {
  id integer [pk, increment]
  user_id integer [ref: > users.id, note: 'SET NULL on delete']
  endpoint varchar(255) [not null]
  method varchar(10) [not null, note: 'GET, POST, PUT, DELETE']
  status_code integer [not null]
  response_time_ms integer
  request_size_bytes integer
  response_size_bytes integer
  ip_address varchar(45)
  created_at timestamp [not null, default: `now()`]
  
  indexes {
    user_id [name: 'idx_usage_user_id']
    endpoint [name: 'idx_usage_endpoint']
    created_at [name: 'idx_usage_created_at']
  }
  
  Note: '''
    API usage tracking for monitoring.
    Created by: API middleware
    Used for: Billing, rate limiting, analytics
  '''
}

// ============================================
// CHROMADB COLLECTIONS (Vector Database)
// ============================================

Table chromadb_embeddings [headercolor: #4A90E2, note: 'ChromaDB Collection'] {
  id varchar(36) [pk, note: 'UUID - matches document_chunks.chroma_id']
  embedding vector [note: '4096-dim vector from Upstage Embedding API']
  document text [note: 'Original text chunk']
  
  // Metadata stored with each embedding
  metadata_document_id integer [note: 'PostgreSQL documents.id']
  metadata_chunk_index integer [note: 'Chunk order in document']
  metadata_page_number integer [note: 'Source page number']
  metadata_char_count integer [note: 'Character count']
  metadata_embedding_model varchar(100) [note: 'Model used for embedding']
  
  Note: '''
    ChromaDB Collection: "documents"
    
    Storage Type: Vector embeddings (4096 dimensions)
    Created by: EmbeddingAgent.process_document()
    Used by: AnalysisAgent._retrieve_relevant_chunks()
    
    Operations:
    - add(): Store new embeddings with metadata
    - query(): Semantic search with similarity
    - delete(): Remove document embeddings
    
    Connection: PostgreSQL document_chunks.chroma_id → ChromaDB.id
  '''
}

// ============================================
// AGENT DATABASE USAGE MATRIX
// ============================================

TableGroup agent_postgresql [note: 'Agents using PostgreSQL'] {
  users
  sessions
  documents
  document_chunks
  chat_messages
  analysis_reports
  search_cache
  search_history
  agent_logs
  api_usage
}

TableGroup agent_chromadb [note: 'Agents using ChromaDB'] {
  chromadb_embeddings
}

// ============================================
// NOTES ON AGENTS
// ============================================

Note agent_embedding_usage {
  '''
  # EmbeddingAgent Database Usage
  
  **PostgreSQL Tables:**
  - `documents` (READ/UPDATE): Get document, update summary & is_indexed
  - `document_chunks` (CREATE): Store text chunks with chroma_id
  - `agent_logs` (CREATE): Log embedding operations
  
  **ChromaDB:**
  - Collection: "documents"
  - Operation: add() - Store embeddings with metadata
  
  **Flow:**
  1. Read document from `documents` table
  2. Extract text from PDF file
  3. Chunk text by tokens
  4. Generate embeddings via Upstage API
  5. Store chunks in `document_chunks`
  6. Store embeddings in ChromaDB
  7. Generate summary via LLM
  8. Update `documents` (summary, is_indexed, indexed_at)
  9. Log to `agent_logs`
  '''
}

Note agent_analysis_usage {
  '''
  # AnalysisAgent Database Usage
  
  **PostgreSQL Tables:**
  - `sessions` (READ): Get session context
  - `documents` (READ): Get selected documents
  - `document_chunks` (READ): Get chunk metadata
  - `chat_messages` (CREATE/READ): Store Q&A, get history
  - `analysis_reports` (CREATE): Store generated reports
  - `agent_logs` (CREATE): Log analysis operations
  
  **ChromaDB:**
  - Collection: "documents"
  - Operation: query() - Vector similarity search
  
  **Flow:**
  1. Get user question and selected documents
  2. Retrieve chat history from `chat_messages`
  3. Query ChromaDB for relevant chunks (RAG)
  4. Get chunk metadata from `document_chunks`
  5. Generate answer via LLM with context
  6. Store Q&A in `chat_messages`
  7. Optionally create `analysis_reports`
  8. Log to `agent_logs`
  '''
}

Note agent_search_usage {
  '''
  # SearchAgent Database Usage
  
  **PostgreSQL Tables:**
  - `search_cache` (READ/CREATE/UPDATE): Cache search results
  - `search_history` (CREATE): Track search patterns
  - `documents` (CREATE): Store downloaded papers
  - `sessions` (READ): Get session context
  - `agent_logs` (CREATE): Log search operations
  
  **ChromaDB:** Not used directly
  
  **Flow:**
  1. Check `search_cache` for existing results
  2. If cache miss, call ArXiv/PubMed API
  3. Filter papers by relevance (LLM)
  4. Store results in `search_cache`
  5. Track in `search_history`
  6. Download PDFs and create `documents`
  7. Log to `agent_logs`
  '''
}

Note agent_general_chat_usage {
  '''
  # GeneralChatAgent Database Usage
  
  **PostgreSQL Tables:**
  - `sessions` (READ): Get session context
  - `chat_messages` (CREATE/READ): Store messages, get history
  - `agent_logs` (CREATE): Log chat operations
  
  **ChromaDB:** Not used
  
  **Flow:**
  1. Get session from `sessions`
  2. Retrieve chat history from `chat_messages`
  3. Generate response via LLM
  4. Store user message in `chat_messages`
  5. Store assistant response in `chat_messages`
  6. Log to `agent_logs`
  '''
}

// ============================================
// DATABASE ARCHITECTURE SUMMARY
// ============================================

Note architecture_summary {
  '''
  # TVA Database Architecture Summary
  
  ## Storage Systems:
  
  ### 1. PostgreSQL (Primary Relational DB)
  - **Purpose**: Structured data, metadata, relationships
  - **Tables**: 11 core tables
  - **Key Features**:
    - ACID transactions
    - Foreign key constraints
    - Cascade deletes
    - Indexes for performance
  
  ### 2. ChromaDB (Vector Database)
  - **Purpose**: Semantic search, RAG
  - **Collections**: 1 main collection ("documents")
  - **Key Features**:
    - 4096-dim embeddings (Upstage)
    - Cosine similarity search
    - Metadata filtering
    - Fast vector retrieval
  
  ## Data Flow:
  
  ```
  PDF Upload
    ↓
  EmbeddingAgent
    ├→ PostgreSQL (metadata, chunks)
    └→ ChromaDB (embeddings)
    ↓
  AnalysisAgent
    ├→ ChromaDB (vector search)
    ├→ PostgreSQL (get context)
    └→ LLM (generate answer)
  ```
  
  ## Agent-Database Matrix:
  
  | Agent          | PostgreSQL | ChromaDB | Primary Tables                          |
  |----------------|------------|----------|-----------------------------------------|
  | EmbeddingAgent | ✓          | ✓        | documents, document_chunks              |
  | AnalysisAgent  | ✓          | ✓        | chat_messages, analysis_reports         |
  | SearchAgent    | ✓          | ✗        | search_cache, search_history, documents |
  | GeneralChat    | ✓          | ✗        | chat_messages                           |
  
  ## Performance Considerations:
  
  - **Indexes**: All foreign keys + frequently queried columns
  - **Caching**: Search results cached for 7 days
  - **Connection Pool**: Max 20 connections, 10 overflow
  - **Vector Search**: ChromaDB optimized for similarity queries
  '''
}
