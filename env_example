# ========= Local dev (.env) =========
# 아래를 복사해서 .env로 만들고 값만 채우면 됩니다.
#
#   cp .env.example .env
#   docker compose up --build
#
# 운영에서는 GitHub Actions Secrets/환경변수로 주입하세요.

# ---------- Upstage ----------
UPSTAGE_API_KEY=
# Upstage base url (필요 시)
UPSTAGE_BASE_URL=https://api.upstage.ai/v1
# Chat model
UPSTAGE_MODEL=solar-pro2
# Embedding model (RAG에서 사용)
UPSTAGE_EMBED_MODEL=solar-embedding-1-large

# ---------- JWT/Auth ----------
JWT_SECRET_KEY=1234
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------- Postgres ----------
; # DB_USER=postgres
; # DB_PASSWORD=password
; # DB_NAME=tva-db
; # DB_HOST=localhost
; # DB_PORT=5432
; # DB_SSLMODE=disable

# ---------- Chroma ----------
CHROMA_HOST=localhost
CHROMA_PORT=8000

NCBI_EMAIL=
NCBI_TOOL=

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:8000/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost

